# EditorConfig — AIDP monorepo
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,json5}]
indent_size = 2

[*.{ts,tsx,js,jsx,mjs,cjs,css,scss,html,md}]
indent_size = 2

[*.proto]
indent_size = 2

[*.{go,rs}]
indent_size = 4

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf
