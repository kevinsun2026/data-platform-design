# AIDP web — pnpm settings
# Skip the pre-run ``verify-deps-before-run`` step so individual
# scripts (``pnpm typecheck`` etc.) don't trip the
# ``ERR_PNPM_IGNORED_BUILDS`` gate for ``unrs-resolver`` (a CJS
# build that's optional in dev — Next.js falls back to a JS
# resolver if it's missing).
verify-deps-before-run=false
